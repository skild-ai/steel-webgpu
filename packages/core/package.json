{
  "name": "@skild-ai/steel-webgpu",
  "version": "0.0.0",
  "description": "WebGPU port of Newton's SolverSteel colored articulated contact path",
  "keywords": [
    "articulation",
    "mjcf",
    "newton",
    "physics",
    "physics-engine",
    "rigid-body",
    "robotics",
    "simulation",
    "urdf",
    "webgpu"
  ],
  "homepage": "https://github.com/skild-ai/steel-webgpu/tree/main/packages/core#readme",
  "bugs": "https://github.com/skild-ai/steel-webgpu/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skild-ai/steel-webgpu.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@skild-ai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "@skild-ai/source": "./src/deviceEntry.ts",
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@webgpu/types": "0.1.74"
  }
}
