{
  "name": "steel-webgpu",
  "version": "0.4.0",
  "description": "WebGPU port of Newton's SolverSteel colored articulated contact path",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/skild-ai/steel-webgpu.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "source": "./src/deviceEntry.ts",
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@webgpu/types": "0.1.74"
  }
}
